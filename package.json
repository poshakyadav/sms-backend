{
  "name": "my-app",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "dotenv -e .dev.vars -- drizzle-kit generate",
    "db:push": "dotenv -e .dev.vars -- drizzle-kit push",
    "db:migrate": "dotenv -e .dev.vars -- drizzle-kit migrate",
    "db:generate:school:dev": "dotenv -e .dev.vars -- drizzle-kit generate --config drizzle.school.dev.config.ts",
    "db:generate:school:prod": "dotenv -e .dev.vars -- drizzle-kit generate --config drizzle.school.prod.config.ts",
    "db:migrate:test": "dotenv -e .dev.vars -- tsx ../migration-node-app/src/server.ts --test",
    "db:migrate:prod": "dotenv -e .dev.vars -- tsx ../migration-node-app/src/server.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.17.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "hono": "^4.11.7",
    "nanoid": "^5.1.6",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nanoid": "^2.1.0",
    "@types/nodemailer": "^7.0.9",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.8.8",
    "vitest": "^4.0.18",
    "wrangler": "^4.62.0"
  }
}
